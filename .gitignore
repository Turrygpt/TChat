node_modules/
dist/
*.log
npm-debug.log*
.env
.DS_Store

# Ресурсы сборки: нужны только иконка и скрипт установщика
build/*
!build/icon.ico
!build/installer.nsh

# Рантайм-данные (история чата, настройки) — не для репозитория
data/

# Кеш озвучки
assets/tts/

# Стикеры, выбранные пользователем (рантайм, у каждого свои)
assets/stickers/

# Кеш эмоуты/бейджи чата, скачанные во время рантайма
assets/chat/badges/
assets/chat/emotes/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk

# Релизы на сервере
releases/

# Дампы потока от рестрима (ffmpeg tee пишет их в корень при отладке)
*.flv

# Кеш котлин-тулинга Android-проекта
android/.kotlin/

/house.zip

# Картинки и звуки алертов, выбранные пользователем: теперь они копируются
# в userData, а старые копии в репозитории — рантайм-мусор. defaults/ остаётся.
assets/alerts/*
!assets/alerts/defaults/
