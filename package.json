{
  "name": "tchat",
  "version": "1.3.16",
  "description": "Standalone-агрегатор стримерских чатов и OBS-виджетов.",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "serve": "node scripts/serve.js",
    "server:check": "node scripts/check-server.js",
    "smoke:test": "node scripts/smoke-test.js",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always",
    "pack": "electron-builder --dir",
    "release": "node deploy/release.js"
  },
  "keywords": [],
  "author": "TChat",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "node-edge-tts": "^1.2.10",
    "socket.io": "^4.8.3",
    "tmi.js": "^1.8.5",
    "ws": "^8.18.0",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tchat.app",
    "productName": "TChat",
    "copyright": "Copyright © 2026 TChat",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "backoffice.html",
      "chat-window.html",
      "patchnotes.json",
      "src/**/*",
      "widgets/**/*",
      "scripts/**/*",
      "assets/**/*",
      "youtube-bypass/**/*",
      "!assets/alerts/{image,sound}-*",
      "!assets/stickers/**",
      "!assets/chat/{badges,emotes}/**",
      "!assets/tts/**",
      "!dist/**",
      "!android/**",
      "!deploy/**",
      "!**/*.map",
      "!node_modules/rxjs/**",
      "!node_modules/json-schema-to-ts/**",
      "!node_modules/ts-algebra/**",
      "!node_modules/@babel/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md",
      "!node_modules/**/{test,tests,__tests__,example,examples,docs}/**",
      "!youtube-bypass/geoip.dat"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TChat",
      "artifactName": "TChat-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Turrygpt",
        "repo": "TChat",
        "releaseType": "release"
      }
    ]
  }
}
